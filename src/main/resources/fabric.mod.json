{
  "schemaVersion": 1,
  "id": "customwatermark",
  "version": "${version}",
  "name": "Custom-Watermark",
  "environment": "client",
  "description": "Adds a customisable text watermark to the game that you can edit using the built-in GUI",
  "authors": ["BlueNightFury46"],
  "contact": {
    "website": "https://bluenightfury46.dev/socials.html"
  },
  "license": "GNU GPL V3",
  "icon": "assets/customwatermark/icon.png",
  "environment": "*",
  "entrypoints": {
    "client": [
      "dev.bluenightfury46.pumpkin.client.PumpkinClient"
    ],
    "main": [
      "dev.bluenightfury46.pumpkin.Pumpkin"
    ]
  },
  "mixins": [
    "customwatermark.mixins.json",
    {
      "config": "customwatermark.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric": "*",
    "minecraft": "${minecraft_version}"
  },
  "custom": {
    "modmenu": {
      "links": {
        "watermark.modmenu.mywebsite": "https://bluenightfury46.dev"
      },
      "website": "https://bluenightfury46.dev",
      "update-checker": true
    }
  }
}
